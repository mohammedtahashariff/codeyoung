# Render provides PORT automatically; do not hardcode it.
NODE_ENV=production

# Set to the deployed Vercel website origin (no trailing slash).
CLIENT_URL=https://your-project.vercel.app

# Render PostgreSQL connection string. Keep the real value in Render's private env settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

MENTOR_DEFAULT_TIMEZONE=Asia/Kolkata
MENTOR_WORK_START_HOUR=10
MENTOR_WORK_END_HOUR=21
MENTOR_MAX_DAILY_CLASSES=2
CLASS_DURATION_MINUTES=45

# Set a newly rotated API key in Render, never commit it here.
RESEND_API_KEY=
# Use a sender verified in Resend for production delivery.
RESEND_FROM=Codeyoung <trial@your-verified-domain.example>
MENTOR_NOTIFICATION_EMAIL=mentor@example.com
