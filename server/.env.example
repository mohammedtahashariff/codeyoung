# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Local database (matches prisma/schema.prisma; no database server required)
DATABASE_URL="file:./dev.db"

# For PostgreSQL deployments, set DATABASE_URL to the provider's connection string
# and generate the client with: npm run prisma:generate:postgres

# Mentor Work Configuration
MENTOR_DEFAULT_TIMEZONE="Asia/Kolkata"
MENTOR_WORK_START_HOUR=10
MENTOR_WORK_END_HOUR=21
MENTOR_MAX_DAILY_CLASSES=2
CLASS_DURATION_MINUTES=45

# Email Configuration (Resend — never commit a real key)
# Use separate credentials for parent confirmation and mentor notifications.
PARENT_RESEND_API_KEY=""
PARENT_RESEND_FROM="Codeyoung <bookings@codeyoung.com>"
MENTOR_RESEND_API_KEY=""
MENTOR_RESEND_FROM="Codeyoung Mentors <mentors@codeyoung.com>"

# Backward-compatible single-key aliases (optional)
RESEND_API_KEY=""
RESEND_FROM="Codeyoung <onboarding@resend.dev>"

# Email Configuration (Nodemailer)
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Codeyoung <trial@codeyoung.com>"
